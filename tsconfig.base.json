{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@rial/types": ["./packages/types/src"],
      "@rial/types/*": ["./packages/types/src/*"],
      "@rial/core": ["./packages/core/src"],
      "@rial/core/*": ["./packages/core/src/*"],
      "@rial/ui": ["./packages/ui/src"],
      "@rial/ui/*": ["./packages/ui/src/*"],
      "@rial/i18n": ["./packages/i18n/src"],
      "@rial/i18n/*": ["./packages/i18n/src/*"],
      "@rial/health": ["./packages/health/src"],
      "@rial/health/*": ["./packages/health/src/*"],
      "@rial/analytics": ["./packages/analytics/src"],
      "@rial/analytics/*": ["./packages/analytics/src/*"],
      "@rial/config": ["./packages/config/src"],
      "@rial/config/*": ["./packages/config/src/*"],
      "@rial/contracts": ["./packages/contracts/src"],
      "@rial/contracts/*": ["./packages/contracts/src/*"],
      "@rial/privacy": ["./packages/privacy/src"],
      "@rial/privacy/*": ["./packages/privacy/src/*"],
      "@rial/tokens": ["./packages/tokens/src"],
      "@rial/tokens/*": ["./packages/tokens/src/*"]
    }
  }
}
