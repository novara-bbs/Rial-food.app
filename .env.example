# ──────────────────────────────────────────────────────────────────────────────
# RIAL App — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
#
# NEVER commit .env.local — it is already in .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ─── Gemini AI ─────────────────────────────────────────────────────────────────
# Used for local development only. In production, move to Supabase secret:
#   supabase secrets set GEMINI_API_KEY=your_key_here
# Get yours at: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Required for: user accounts, cloud sync, AI proxy, GDPR deletion
# Create a project at: https://supabase.com
# Find values at: Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── RevenueCat ────────────────────────────────────────────────────────────────
# Required for: in-app subscriptions (RIAL+)
# Create a project at: https://app.revenuecat.com
# iOS key: Project → API Keys → Public Apple API key
# Android key: Project → API Keys → Public Google API key
VITE_RC_APPLE_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_RC_GOOGLE_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Sentry ────────────────────────────────────────────────────────────────────
# Optional — crash reporting and performance monitoring
# Create a project at: https://sentry.io
VITE_SENTRY_DSN=

# ─── App URL ───────────────────────────────────────────────────────────────────
# Auto-set in production (Vercel injects VERCEL_URL). Only needed locally.
APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# SUPABASE EDGE FUNCTION SECRETS (set via CLI, not in .env.local)
# These are never in the client bundle — server-side only.
# Run once to configure:
#
#   supabase secrets set GEMINI_API_KEY=your_gemini_api_key_here
#
# The SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are automatically
# injected by Supabase into Edge Functions — no manual configuration needed.
# ──────────────────────────────────────────────────────────────────────────────
