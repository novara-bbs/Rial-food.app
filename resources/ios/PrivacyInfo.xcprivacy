<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple Privacy Manifest — Required since May 2024 for all App Store submissions.
  Declares all "Required Reason APIs" used by the app and its dependencies.

  SETUP: After running `npx cap add ios`, run:
    npm run cap:setup:ios
  This script copies this file to ios/App/App/ and adds it to the Xcode project.

  Reference: https://developer.apple.com/documentation/bundleresources/privacy_manifest_files
-->
<plist version="1.0">
<dict>
  <!-- No cross-site tracking -->
  <key>NSPrivacyTracking</key>
  <false/>

  <!-- Tracking domains (empty — no cross-site tracking) -->
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <!-- ─── Required Reason APIs ───────────────────────────────────────────── -->
  <!--
    These are system APIs with "required reasons" per Apple's documentation.
    Capacitor/WKWebView uses all four categories below.
  -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>

    <!-- File timestamps: Capacitor reads file metadata for cache management -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- C617.1: Accessing file timestamps for files the app manages -->
        <string>C617.1</string>
      </array>
    </dict>

    <!-- UserDefaults: WKWebView uses NSUserDefaults for localStorage persistence -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- CA92.1: Accessing user defaults from same-team app or extension -->
        <string>CA92.1</string>
      </array>
    </dict>

    <!-- Disk space: Capacitor checks available storage for media caching -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- E174.1: Show disk space available to the user on-screen -->
        <string>E174.1</string>
      </array>
    </dict>

    <!-- System boot time: Used by Capacitor performance/timing utilities -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- 35F9.1: Calculate duration on device for app functions -->
        <string>35F9.1</string>
      </array>
    </dict>

  </array>

  <!-- ─── Collected Data Types ──────────────────────────────────────────── -->
  <!--
    Declare all data types the app collects. These feed the App Store
    "Data Nutrition Label" shown on the product page.
  -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array>

    <!-- Email address: used for account creation via Supabase Auth -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Health & fitness data: nutrition logs, weight, sleep, wellness check-ins -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeHealth</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Fitness: fasting timers, workout activity tracking -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeFitness</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- User content: recipes, social posts, AI coach messages -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Crash data: Sentry crash reports (not linked to identity) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCrashData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Performance data: app launch time, Sentry performance traces -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePerformanceData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

  </array>

</dict>
</plist>
